# insight-face — copy to .env and edit only this file:
#   cp .env.example .env
#
# Local (defaults below work with: docker compose up -d db redis)
# Staging — change at minimum:
#   DJANGO_DEBUG=False
#   DJANGO_SECRET_KEY=<python -c "import secrets; print(secrets.token_urlsafe(50))">
#   DJANGO_ALLOWED_HOSTS=newmodel.snapdme.com
#   DB_PASSWORD=<strong password matching docker-compose POSTGRES_PASSWORD>

DJANGO_SECRET_KEY=dev-only-insecure-key-change-for-staging
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

DB_NAME=insight_face
DB_USER=chetanface
DB_PASSWORD=local-dev-password
DB_HOST=localhost
# Use 5433 for Docker pgvector — do NOT use 5432 if system PostgreSQL is installed
DB_PORT=5433

CELERY_BROKER_URL=redis://localhost:6379/0
REDIS_PORT=6379
