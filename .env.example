# insight-face — copy to .env and edit only this file:
#   cp .env.example .env
#
# ── Local dev (defaults below) ─────────────────────────────────────────────
#   docker compose up -d db redis
#   DB_HOST=localhost  DB_PORT=5433
#
# ── Staging (newmodel.snapdme.com) ─────────────────────────────────────────
#   DJANGO_DEBUG=False
#   DJANGO_SECRET_KEY=<python -c "import secrets; print(secrets.token_urlsafe(50))">
#   DJANGO_ALLOWED_HOSTS=newmodel.snapdme.com
#   DJANGO_CSRF_TRUSTED_ORIGINS=https://newmodel.snapdme.com
#   DB_PASSWORD=<strong-password>
#   INSIGHTFACE_CTX_ID=-1
#   USE_R2_STORAGE=True  (+ fill R2_* vars below)
#
# Nginx HTTPS must proxy to Gunicorn on port 8010 (not 8000).
# Later RDS: DB_HOST=<rds-endpoint>  DB_PORT=5432  + CREATE EXTENSION vector;

DJANGO_SECRET_KEY=dev-only-insecure-key-change-for-staging
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=

# Docker pgvector (docker-compose.yml)
DB_NAME=insight_face
DB_USER=chetanface
DB_PASSWORD=local-dev-password
DB_HOST=localhost
DB_PORT=5433

CELERY_BROKER_URL=redis://localhost:6379/0
REDIS_PORT=6379

# Redis cache backend (DB 1 keeps it separate from the Celery broker on DB 0)
REDIS_CACHE_URL=redis://localhost:6379/1

# Search result cache TTL in seconds (5 min default)
SEARCH_CACHE_TTL=300

# Celery workers — use 1 on CPU staging (each worker loads ~500MB models)
# Staging: CELERY_WORKER_CONCURRENCY=1
# GPU server with enough RAM: 2–4
CELERY_WORKER_CONCURRENCY=1

# Photos per GPU batch in process_album_embeddings (tune to GPU VRAM)
ALBUM_PHOTO_BATCH_SIZE=8

# Face crops per ONNX forward pass (GPU batching inside AdaFace)
REC_BATCH_SIZE=16

# AdaFace pipeline: -1 = CPU (staging default), 0 = GPU
# First run downloads models to ~/.insightface/models/adaface/
INSIGHTFACE_CTX_ID=-1

# ── Media storage (local vs Cloudflare R2) ─────────────────────────────────
# Local dev: leave USE_R2_STORAGE=False (files under ./media/)
# Staging/prod: USE_R2_STORAGE=True and fill the R2_* values below
USE_R2_STORAGE=False

# Cloudflare R2 API token (S3-compatible access key + secret)
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# Bucket name in your Cloudflare account
R2_BUCKET_NAME=

# Account ID from Cloudflare dashboard (used to build endpoint if R2_ENDPOINT_URL is empty)
R2_ACCOUNT_ID=

# S3 API endpoint — optional if R2_ACCOUNT_ID is set
# https://<R2_ACCOUNT_ID>.r2.cloudflarestorage.com
R2_ENDPOINT_URL=

# boto3 region for R2 (always "auto")
R2_REGION_NAME=auto

# Public base URL for uploaded photos — used in API responses (NOT the S3 API endpoint above)
# Must include bucket name in the path for r2.dev public buckets:
#   https://pub-<hash>.r2.dev/<bucket-name>
# Example: https://pub-05e07b44097345e9a2043defea3075a5.r2.dev/snapdme-testing
R2_MEDIA_URL=

# Set True only if the bucket is private and URLs must be signed
R2_QUERYSTRING_AUTH=False
