# insight-face — copy to .env and edit only this file:
#   cp .env.example .env
#
# ── Local dev (defaults below) ─────────────────────────────────────────────
#   docker compose up -d db redis
#   DB_HOST=localhost  DB_PORT=5433
#
# ── Staging (newmodel.snapdme.com) ─────────────────────────────────────────
#   DJANGO_DEBUG=False
#   DJANGO_SECRET_KEY=<python -c "import secrets; print(secrets.token_urlsafe(50))">
#   DJANGO_ALLOWED_HOSTS=newmodel.snapdme.com
#   DJANGO_CSRF_TRUSTED_ORIGINS=https://newmodel.snapdme.com
#   DB_PASSWORD=<strong-password>
#   INSIGHTFACE_CTX_ID=-1
#   USE_R2_STORAGE=True  (+ fill R2_* vars below)
#
# Nginx HTTPS must proxy to Gunicorn on port 8010 (not 8000).
# Later RDS: DB_HOST=<rds-endpoint>  DB_PORT=5432  + CREATE EXTENSION vector;

DJANGO_SECRET_KEY=dev-only-insecure-key-change-for-staging
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=

# Docker pgvector (docker-compose.yml)
DB_NAME=insight_face
DB_USER=chetanface
DB_PASSWORD=local-dev-password
DB_HOST=localhost
DB_PORT=5433

CELERY_BROKER_URL=redis://localhost:6379/0
REDIS_PORT=6379

# Redis cache backend (DB 1 keeps it separate from the Celery broker on DB 0)
REDIS_CACHE_URL=redis://localhost:6379/1

# Search result cache TTL in seconds (5 min default)
SEARCH_CACHE_TTL=300

# Celery workers — use 1 on CPU staging (each worker loads ~700MB models)
# CPU with RAM > 3 GB: 2   |   GPU server: 1 (GPU is shared)
CELERY_WORKER_CONCURRENCY=1

# Photos per batch in process_album_embeddings
# CPU: 16–24   |   GPU: 32–64
ALBUM_PHOTO_BATCH_SIZE=16

# Face crops per ONNX forward pass (AdaFace recognition batching)
# CPU: 32   |   GPU: 64–128
REC_BATCH_SIZE=32

# AdaFace pipeline: -1 = CPU (staging default), 0 = GPU
# First run downloads models to ~/.insightface/models/adaface/
INSIGHTFACE_CTX_ID=-1

# ── R2 download parallelism ────────────────────────────────────────────────
# Concurrent R2 downloads per album chunk (boto3 is thread-safe)
# CPU: 4   |   GPU / fast network: 8
R2_DOWNLOAD_THREADS=4

# ── ONNX Runtime performance tuning ────────────────────────────────────────
# Thread counts for ONNX kernels (0 = let ORT decide, recommended: 4–6 on CPU)
ORT_INTRA_THREADS=0
ORT_INTER_THREADS=1

# Directory to cache ORT-optimized model graphs (speeds up worker restarts).
# Set to the model pack dir, e.g. /root/.insightface/models/adaface
# Leave blank to disable caching.
ORT_OPTIMIZED_MODEL_DIR=

# Active AdaFace model — switch to INT8 after running scripts/quantize_adaface.py
# FP32 (default):  ADAFACE_MODEL_FILENAME=adaface_ir101_webface12m.onnx
# INT8 (faster):   ADAFACE_MODEL_FILENAME=adaface_ir101_webface12m_int8.onnx
ADAFACE_MODEL_FILENAME=adaface_ir101_webface12m.onnx

# ── Media storage (local vs Cloudflare R2) ─────────────────────────────────
# Local dev: leave USE_R2_STORAGE=False (files under ./media/)
# Staging/prod: USE_R2_STORAGE=True and fill the R2_* values below
USE_R2_STORAGE=False

# Cloudflare R2 API token (S3-compatible access key + secret)
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# Bucket name in your Cloudflare account
R2_BUCKET_NAME=

# Account ID from Cloudflare dashboard (used to build endpoint if R2_ENDPOINT_URL is empty)
R2_ACCOUNT_ID=

# S3 API endpoint — optional if R2_ACCOUNT_ID is set
# https://<R2_ACCOUNT_ID>.r2.cloudflarestorage.com
R2_ENDPOINT_URL=

# boto3 region for R2 (always "auto")
R2_REGION_NAME=auto

# Public base URL for uploaded photos — used in API responses (NOT the S3 API endpoint above)
# Must include bucket name in the path for r2.dev public buckets:
#   https://pub-<hash>.r2.dev/<bucket-name>
# Example: https://pub-05e07b44097345e9a2043defea3075a5.r2.dev/snapdme-testing
R2_MEDIA_URL=

# Set True only if the bucket is private and URLs must be signed
R2_QUERYSTRING_AUTH=False

# ── RunPod serverless GPU inference ───────────────────────────────────────
# Set USE_RUNPOD=True to dispatch ONNX inference (photo uploads + album processing)
# to RunPod GPU pods instead of local CPU. The /api/search/ endpoint always
# uses local CPU regardless of this setting.
# When False (default), everything runs locally — no regression.
USE_RUNPOD=False

# API key from https://www.runpod.io/console/user/settings → API Keys
RUNPOD_API_KEY=

# Endpoint ID copied from https://www.runpod.io/console/serverless after deploy
RUNPOD_ENDPOINT_ID=

# Timeout (seconds) for the /runsync HTTP call.
# Increase to 180+ if cold starts take longer (first request after idle).
RUNPOD_TIMEOUT=120
